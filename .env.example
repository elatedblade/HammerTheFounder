# Docker Compose service configuration. Keep the hostnames as service names
# when these values are consumed by containers.
POSTGRES_DB=htf
POSTGRES_USER=htf
POSTGRES_PASSWORD=htf
DATABASE_URL=postgresql://htf:htf@postgres:5432/htf
REDIS_URL=redis://redis:6379/0
# Redis database used by Django's shared production cache/rate limiter.
CACHE_URL=redis://redis:6379/1

DJANGO_SECRET_KEY=replace-this-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_MODE=unconfigured

# Managed authentication (Clerk development instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Private resume storage. Keep the bucket private and enable Block Public Access.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

CLERK_ISSUER_URL=
CLERK_JWT_AUDIENCE=
CLERK_JWT_PUBLIC_KEY=
CLERK_JWKS_URL=

# Supporting services are optional. Empty values disable the respective action.
HTF_TIME_ZONE=Asia/Kolkata
UPI_ID=
UPI_PAYEE_NAME=
UPI_INSTRUCTIONS=
# Business WhatsApp destination: country code + digits only, no plus sign.
WHATSAPP_BUSINESS_NUMBER=
# Public support mailbox only (single plain address, no display name or mailto:
# prefix). Leave blank until a real monitored mailbox is configured.
SUPPORT_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
HTF_ENVIRONMENT=development
HTF_RELEASE=
