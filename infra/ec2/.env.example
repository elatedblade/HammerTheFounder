# Copy to infra/ec2/.env (never commit the copy). Values below are placeholders.
BACKEND_IMAGE=
CLIENT_IMAGE=
ADMIN_IMAGE=
POSTGRES_DB=htf
POSTGRES_USER=htf
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://htf:CHANGE_ME@postgres:5432/htf
REDIS_URL=redis://redis:6379/0
DJANGO_SETTINGS_MODULE=config.settings.evaluation
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=
CLERK_JWT_AUDIENCE=
CLERK_JWT_PUBLIC_KEY=
CLERK_JWKS_URL=
WEB_CONCURRENCY=1
CELERY_CONCURRENCY=1
WHATSAPP_BUSINESS_NUMBER=
# Public support mailbox only: single plain address, no display name or mailto:
# prefix. Leave blank until a real monitored mailbox is configured.
SUPPORT_EMAIL=
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
